<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/task_editor_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FaceDragons.DialogTitle"
            android:textSize="24sp" />

        <EditText
            android:id="@+id/task_editor_title_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/seed"
            android:fontFamily="serif"
            android:hint="@string/task_editor_title_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minLines="2"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="20sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fadeScrollbars="false"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/task_editor_meta_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="false"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="4dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/task_editor_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_bottom_bar"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp">

            <ImageButton
                android:id="@+id/task_editor_context_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/task_add_context"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_task_context"
                android:tint="@color/seed" />

            <ImageButton
                android:id="@+id/task_editor_project_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/task_add_project"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_task_project"
                android:tint="@color/seed" />

            <ImageButton
                android:id="@+id/task_editor_area_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/task_add_area"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_task_aof"
                android:tint="@color/seed" />

            <ImageButton
                android:id="@+id/task_editor_priority_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/task_add_priority"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_task_priority"
                android:tint="@color/seed" />

            <ImageButton
                android:id="@+id/task_editor_due_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/task_add_due_date"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_task_due"
                android:tint="@color/seed" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/task_editor_save_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/task_editor_save"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_save"
                android:tint="@color/seed" />
        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
