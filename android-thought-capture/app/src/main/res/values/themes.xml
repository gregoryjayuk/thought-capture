<resources>
    <style name="Theme.ThoughtCapture" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/seed</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FaceDragons.AlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.FaceDragons.BottomSheetDialog</item>
    </style>

    <style name="ThemeOverlay.FaceDragons.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.FaceDragons.Dialog</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.FaceDragons.Button.Quiet</item>
    </style>

    <style name="ThemeOverlay.FaceDragons.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.FaceDragons.BottomSheet</item>
    </style>

    <style name="Widget.FaceDragons.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_sheet_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FaceDragons.Sheet</item>
    </style>

    <style name="ShapeAppearance.FaceDragons.Dialog" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.FaceDragons.Sheet" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="TextAppearance.FaceDragons.HeroTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hero_title</item>
    </style>

    <style name="TextAppearance.FaceDragons.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FaceDragons.ItemTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FaceDragons.DialogTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.FaceDragons.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/seed</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.FaceDragons.Button.Quiet" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/surface_outline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.FaceDragons.Button.Mini" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/surface_outline</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Widget.FaceDragons.Button.MiniPrimary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/seed_soft</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="ThoughtCaptureCircleShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
